{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LiuXiYing/course-pr-reviewer/schemas/course-review.schema.json",
  "title": "Course review configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "course", "features", "assignments"],
  "properties": {
    "version": {"const": 1},
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "timezone"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "稳定的课程标识，写入 grades 收据；建议用小写连字符"
        },
        "timezone": {"type": "string", "minLength": 1, "maxLength": 100},
        "title_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "default": "[{student_id}{student_name}]{assignment_id}作业提交"
        },
        "submission_path_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "default": "{student_id}{student_name}/{assignment_id}"
        },
        "merge_method": {"enum": ["merge", "squash", "rebase"], "default": "merge"},
        "final_accept_at": {
          "type": "string",
          "format": "date-time",
          "description": "全课程最终收件截止；必须带时区，且晚于每个 tiered 作业的 deadline"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auto_merge", "comment_review", "close_late_pr", "ai_review", "ocr_review", "vision_review", "metrics"],
      "properties": {
        "auto_merge": {"type": "boolean"},
        "comment_review": {"type": "boolean"},
        "close_late_pr": {"type": "boolean"},
        "ai_review": {"type": "boolean"},
        "ai_feedback": {"type": "boolean", "default": false},
        "ocr_review": {"type": "boolean"},
        "vision_review": {"type": "boolean"},
        "metrics": {"type": "boolean"},
        "grading": {
          "type": "boolean",
          "default": false,
          "description": "开启后按 grading 块计算成绩并写入 grades 分支；迟交不再阻止合并"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_nonempty_lines": {"type": "integer", "minimum": 0, "maximum": 10000},
        "allow_extra_files": {"type": "boolean"},
        "late_close_after_days": {"type": "integer", "minimum": 0, "maximum": 365}
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage", "defaults"],
      "properties": {
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branch": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$",
              "default": "grades"
            },
            "schema_version": {"const": 1},
            "write_receipts": {"type": "boolean", "default": true},
            "export_on_finalize": {"type": "boolean", "default": false}
          }
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[A-Za-z0-9._-]+$",
          "default": "2026-fall-v1"
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_points": {"$ref": "#/$defs/points", "default": "10.00"},
            "legacy": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "record_completion": {"type": "boolean", "default": true},
                "fixed_points": {
                  "oneOf": [{"$ref": "#/$defs/points"}, {"type": "null"}],
                  "default": null
                }
              }
            },
            "tiered": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "grace": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {"type": "boolean", "default": true},
                    "hours": {"type": "integer", "minimum": 0, "maximum": 720, "default": 48},
                    "require_substantive_snapshot": {"type": "boolean", "default": true}
                  }
                },
                "bands": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {"$ref": "#/$defs/band"}
                },
                "after_final_accept": {
                  "enum": ["reject_merge", "accept_unscored"],
                  "default": "reject_merge"
                }
              }
            }
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["glm", "gemini"], "default": "glm"},
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]+$",
          "default": "glm-4.7-flash"
        },
        "providers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/providerModel"}
        },
        "consensus_rounds": {"type": "integer", "minimum": 1, "maximum": 3, "description": "双模型默认最多审核 3 轮；单模型必须为 1"},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.8},
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 300, "default": 60},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3},
        "max_file_bytes": {"type": "integer", "minimum": 1000, "maximum": 1000000, "default": 200000},
        "max_total_bytes": {"type": "integer", "minimum": 1000, "maximum": 2000000, "default": 500000},
        "max_output_tokens": {"type": "integer", "minimum": 256, "maximum": 8192, "default": 2048}
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 30, "default": 20},
        "max_input_bytes": {"type": "integer", "minimum": 1000, "maximum": 500000, "default": 100000},
        "max_output_tokens": {"type": "integer", "minimum": 256, "maximum": 4096, "default": 2048}
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detection_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]+$",
          "default": "PP-OCRv6_small_det"
        },
        "recognition_model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]+$",
          "default": "PP-OCRv6_small_rec"
        },
        "min_line_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.65},
        "max_text_chars": {"type": "integer", "minimum": 100, "maximum": 100000, "default": 20000}
      }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["glm", "gemini"], "default": "glm"},
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]+$",
          "default": "glm-4.6v-flash"
        },
        "providers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/providerModel"}
        },
        "consensus_rounds": {"type": "integer", "minimum": 1, "maximum": 3, "description": "双模型默认最多审核 3 轮；单模型必须为 1"},
        "min_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.85},
        "fail_confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.9},
        "timeout_seconds": {"type": "integer", "minimum": 5, "maximum": 300, "default": 90},
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5, "default": 3},
        "max_images": {"type": "integer", "minimum": 1, "maximum": 20, "default": 6},
        "max_image_bytes": {"type": "integer", "minimum": 10000, "maximum": 20000000, "default": 5000000},
        "max_total_bytes": {"type": "integer", "minimum": 10000, "maximum": 50000000, "default": 12000000},
        "max_pixels": {"type": "integer", "minimum": 10000, "maximum": 100000000, "default": 25000000},
        "max_side": {"type": "integer", "minimum": 256, "maximum": 10000, "default": 4096},
        "max_output_tokens": {"type": "integer", "minimum": 256, "maximum": 8192, "default": 2048}
      }
    },
    "assignments": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_-]{0,49}$"},
      "additionalProperties": {"$ref": "#/$defs/assignment"}
    }
  },
  "$defs": {
    "points": {
      "type": "string",
      "description": "十进制分值，最多两位小数，例如 \"10.00\"；避免二进制浮点误差",
      "pattern": "^(0|[1-9][0-9]{0,5})(\\.[0-9]{1,2})?$"
    },
    "band": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_late_hours", "cap_percent"],
      "properties": {
        "max_late_hours": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 100000},
            {"type": "null"}
          ]
        },
        "cap_percent": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "providerModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"enum": ["glm", "gemini"]},
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]+$"
        }
      }
    },
    "relativeFile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^\\n\\r\\u0000]+$"
    },
    "requiredFile": {
      "oneOf": [
        {"$ref": "#/$defs/relativeFile"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["one_of"],
          "properties": {
            "one_of": {
              "type": "array",
              "minItems": 2,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/relativeFile"}
            }
          }
        }
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline", "required_files"],
      "properties": {
        "enabled": {"type": "boolean", "default": true},
        "deadline": {"type": "string", "format": "date-time"},
        "report_template": {"$ref": "#/$defs/relativeFile"},
        "template_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": {"type": "boolean", "default": false},
            "report_file": {"$ref": "#/$defs/relativeFile"},
            "max_file_bytes": {"type": "integer", "minimum": 1000, "maximum": 1000000, "default": 200000},
            "characters": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "uniqueItems": true,
              "items": {"enum": ["#", "-", "*", "`", "|", ">", "_", "[", "]", "(", ")", "!", "~", "+", "\\"]}
            }
          }
        },
        "required_address_cells": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "section", "row", "columns"],
            "properties": {
              "file": {"$ref": "#/$defs/relativeFile"},
              "section": {"type": "string", "minLength": 1, "maxLength": 100},
              "row": {"type": "string", "minLength": 1, "maxLength": 255},
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 1, "maximum": 100}
              }
            }
          }
        },
        "required_files": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/requiredFile"}
        },
        "vision_files": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/relativeFile"}
        },
        "review_points": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "vision_review_points": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "min_nonempty_lines": {"type": "integer", "minimum": 0, "maximum": 10000},
        "allow_extra_files": {"type": "boolean"},
        "ai_review": {"type": "boolean"},
        "ocr_review": {"type": "boolean"},
        "vision_review": {"type": "boolean"},
        "grading": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["legacy", "tiered"]},
            "max_points": {"$ref": "#/$defs/points"}
          }
        }
      }
    }
  }
}
