{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LiuXiYing/course-pr-reviewer/schemas/students.schema.json",
  "title": "Course student roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "students"],
  "properties": {
    "version": {"const": 1},
    "students": {
      "type": "object",
      "propertyNames": {"pattern": "^[0-9]{10}$"},
      "additionalProperties": {"$ref": "#/$defs/student"}
    }
  },
  "$defs": {
    "student": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "github"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[^/\\\\{}\\n\\r]+$"
        },
        "github": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "class": {"type": "string", "minLength": 1, "maxLength": 100},
        "active": {"type": "boolean", "default": true}
      }
    }
  }
}
