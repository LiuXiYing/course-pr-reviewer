{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LiuXiYing/course-pr-reviewer/schemas/review-result.schema.json",
  "title": "Course PR review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision", "summary", "reason_codes", "issues", "metadata"],
  "properties": {
    "schema_version": {"const": 1},
    "decision": {"enum": ["PASS", "FAIL", "MANUAL_REVIEW", "ERROR"]},
    "summary": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "metadata": {"type": "object"}
  }
}
