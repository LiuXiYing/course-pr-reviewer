{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LiuXiYing/course-pr-reviewer/schemas/feedback.schema.json",
  "title": "Student-facing explanation of an existing review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "groups"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "maxLength": 1500, "pattern": "\\S"},
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "issue_numbers", "explanation", "suggestions"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
          "issue_numbers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "explanation": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"},
          "suggestions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}
          }
        }
      }
    }
  }
}
